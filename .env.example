# Copy to .env and adjust.

# URL of your Frigate instance (the authenticated port / reverse-proxied URL). Required.
FRIGATE_URL=https://frigate.example.com

# Set to false if Frigate uses a self-signed certificate.
FRIGATE_VERIFY_TLS=true

# App name shown in the title bar, login screen and on the home screen when installed.
APP_NAME=Frigate Cam
# Short name under the home screen icon (defaults to APP_NAME).
APP_SHORT_NAME=

# Camera selected on first load (default: the first enabled camera).
DEFAULT_CAMERA=

# How many days the browser stays signed in. Frigate's own auth.session_length still applies.
SESSION_DAYS=30
